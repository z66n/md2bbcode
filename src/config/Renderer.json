{
    "prefix": {
        "markdown": "(markdown) => ",
        "code": "(code, language) => ",
        "blockquote": "(quote) => ",
        "html": "(html) => ",
        "heading": "(text, level) => ",
        "hr": "() => ",
        "list": "(body, ordered) => ",
        "listitem": "(text) => ",
        "paragraph": "(text) => ",
        "table": "(header, body) => ",
        "tablerow": "(content) => ",
        "tablecell": "(content, header, align) => ",
        "strong": "(text) => ",
        "em": "(text) => ",
        "codespan": "(code) => ",
        "br": "() => ",
        "del": "(text) => ",
        "link": "(href, title, text) => ",
        "image": "(href, title, text) => ",
        "text": "(text) => "
    },
    "suffix": {
        "markdown": "${(s=>{let e=document.createElement('textarea');e.innerHTML=s.replace(/\\n/g, ' ');return e.value})(markdown)}",
        "code": "[code]${code}[/code]\\n",
        "blockquote": "[quote]${quote.replace(/\\n+$/,'')}[/quote]\\n",
        "html": "${((d,s)=>d.createElement('span').appendChild(d.createTextNode(s)).parentNode.innerHTML)(document,html)}",
        "heading": "[size=${[20,18,17,16,15,14][level-1]}px]${text}[/size]\\n\\n",
        "hr": "[hr]\\n",
        "list": "[list${ordered?'=1':''}]\\n${body.replace(/\\n+$/,'')}\\n[/list]\\n",
        "listitem": "[*]${text.replace(/\\n+$/,'')}\\n",
        "paragraph": "${text}\\n\\n",
        "table": "[align=center][table=98%]\\n${header}${body}[/table][/align]\\n",
        "tablerow": "[tr]${content}[/tr]\\n",
        "tablecell": "[td]${header?'[b]'+content+'[/b]':content}[/td]",
        "strong": "[b]${text}[/b]",
        "em": "[i]${text}[/i]",
        "codespan": "[font=Monaco,Consolas,'Lucida Console','Courier New',serif]${code}[/font]",
        "br": "\\n",
        "del": "[s]${text}[/s]",
        "link": "[url=${href}]${text}[/url]",
        "image": "[img]${href}[/img]",
        "text": "${text}"
    }
}
